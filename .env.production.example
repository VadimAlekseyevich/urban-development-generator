# Copy to .env.production (NEVER commit the populated file).
# Supply real reachable EXTERNAL endpoints and least-privileged credentials.
APP_ENV=production
APP_DEBUG=false
DATABASE_URL=postgresql+psycopg://udg_app:replace-me@postgres.internal:5432/urban_generator
REDIS_URL=redis://:replace-me@redis.internal:6379/0

# This profile forces S3; no ephemeral local ArtifactStore writes.
ARTIFACT_STORE_BACKEND=s3
S3_ENDPOINT_URL=https://s3.example.internal
S3_BUCKET=replace-with-existing-private-bucket
S3_ACCESS_KEY=replace-with-least-privileged-access-key
S3_SECRET_KEY=replace-with-actual-secret
S3_REGION=us-east-1
S3_PREFIX=urban-generator
S3_FORCE_PATH_STYLE=true
S3_VERIFY_TLS=true

# Protect internal /internal/metrics and keep it off the nginx public route.
METRICS_BEARER_TOKEN=replace-with-a-long-random-32-character-token
STORAGE_ROOT=/tmp/unused-local-store
MAX_UPLOAD_SIZE_MB=1024
CORS_ORIGINS= # Same-origin nginx proxy needs no browser cross-origin access.
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=8080

WORKER_INGEST_MAX_JOBS=2
WORKER_GENERATION_MAX_JOBS=1
WORKER_ANALYSIS_MAX_JOBS=1
WORKER_EXPORT_MAX_JOBS=1
MAX_ACTIVE_JOBS_PER_PROJECT=16
MAX_ACTIVE_GENERATION_JOBS_PER_PROJECT=10
MAX_ACTIVE_INGEST_JOBS_PER_PROJECT=4
MAX_ACTIVE_EXPORT_JOBS_PER_PROJECT=4

ARTIFACT_GC_DRY_RUN=true
ARTIFACT_GC_MIN_AGE_HOURS=2
ARTIFACT_GC_MAX_BATCH=50
ARTIFACT_GC_MAX_SCAN=5000
